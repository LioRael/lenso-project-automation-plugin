{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["idempotency_key","organization_id","rule_id","expected_revision","name","trigger","conditions","actions"],
  "properties":{
    "idempotency_key":{"type":"string"},"organization_id":{"type":"string"},"rule_id":{"type":"string"},"expected_revision":{"type":"string","pattern":"^[1-9][0-9]*$"},"name":{"type":"string"},
    "trigger":{"$ref":"rule-response.schema.json#/$defs/Trigger"},"conditions":{"type":"array","items":{"$ref":"rule-response.schema.json#/$defs/Condition"}},
    "actions":{"type":"array","items":{"$ref":"rule-response.schema.json#/$defs/Action"}}
  }
}
