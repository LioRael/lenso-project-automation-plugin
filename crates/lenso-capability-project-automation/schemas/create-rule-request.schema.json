    "idempotency_key":{"type":"string"},"organization_id":{"type":"string"},"rule_id":{"type":"string"},"name":{"type":"string"},"enabled":{"type":"boolean"},
    "trigger":{"$ref":"rule-response.schema.json#/$defs/Trigger"},"conditions":{"type":"array","items":{"$ref":"rule-response.schema.json#/$defs/Condition"}},
    "actions":{"type":"array","items":{"$ref":"rule-response.schema.json#/$defs/Action"}}
  }
}
